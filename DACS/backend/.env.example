# Biến môi trường mẫu — SAO CHÉP THÀNH .env và điền giá trị thực

PORT=5000

# ============================================================
# SUPABASE - Lấy từ: https://app.supabase.com → Settings → API
# ============================================================

# Project URL (dạng: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# anon/public key
SUPABASE_ANON_KEY=your-anon-key-here

# service_role key (CHỈ dùng ở backend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ============================================================
# BẢO MẬT & EMAIL
# ============================================================

# Khoá ký JWT của hệ thống (BẮT BUỘC đặt chuỗi ngẫu nhiên dài, KHÔNG commit lên git)
# Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-secret

# Địa chỉ frontend (CORS)
FRONTEND_URL=http://localhost:3000

# Gmail gửi OTP quên mật khẩu & thông báo cho sinh viên (dùng App Password của Google)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Đặt 1 khi deploy sau reverse proxy (Render/Nginx) để giới hạn tần suất nhận đúng IP
TRUST_PROXY=0
