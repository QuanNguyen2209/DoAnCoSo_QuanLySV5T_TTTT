PORT=5000

# ============================================================
# SUPABASE - Lấy từ: https://app.supabase.com → Settings → API
# ============================================================

# Project URL (dạng: https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# anon/public key (dùng ở frontend nếu cần)
SUPABASE_ANON_KEY=your-anon-key-here

# service_role key (CHỈ dùng ở backend - có toàn quyền DB)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret (lấy từ Settings → API → JWT Settings)
SUPABASE_JWT_SECRET=your-jwt-secret-here
